__pycache__/
*.pyc
.venv/
.ruff_cache/

# Datos regenerables — la caché de mercado se reconstruye sola
data/*.db
# En WAL, SQLite deja además estos dos al lado de la base. Son tan regenerables
# como ella y cambian en cada consulta: versionarlos es ruido binario puro.
data/*.db-wal
data/*.db-shm
data/*.json
!data/.gitkeep
# ...menos los eventos del MEP: no son datos de nadie, son las anotaciones
# macro que el panel del dólar dibuja sobre la serie. Son parte del análisis y
# tienen que viajar con el código, o el server queda sin ellas.
!data/eventos_mep.json

# Credenciales — NUNCA versionar
connectors.json
*.enc
.env
# credenciales cifradas + la clave que las abre (config.json)
data/vault/
# secreto que firma los sobres de sesión del modo web
data/secreto_sesion
# carteras de los usuarios de la web, una carpeta por identidad de Google
data/usuarios/
# backups de carteras y realizado
data/*.bak*
# y los que uno se guarda a mano en la raíz: son carteras, o sea datos de alguien
backup*/

# Frontend compilado (se genera desde web/app.jsx)
web/app.js

# entorno local
.venv/
node_modules/
